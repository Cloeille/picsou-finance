{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picsou",
  "identifier": "com.picsou.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Picsou",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../runtime/": "runtime/"
    },
    "category": "Finance",
    "shortDescription": "Personal finance dashboard",
    "windows": {
      "nsis": {"installMode": "currentUser"}
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  }
}
