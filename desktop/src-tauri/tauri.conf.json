{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picsou",
  "version": "1.1.0",
  "identifier": "com.picsou.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Picsou",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../runtime/": "runtime/"
    },
    "category": "Finance",
    "shortDescription": "Personal finance dashboard"
  }
}
