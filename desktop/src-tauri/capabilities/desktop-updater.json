{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-updater",
  "description": "The main window on the local loopback backend may query, check and install desktop updates and listen for update events.",
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["main"],
  "permissions": [
    "allow-get-desktop-update-status",
    "allow-check-desktop-update",
    "allow-install-desktop-update",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
