# syntax=docker/dockerfile:1
# ============================================================
# Picsou — public demo image (frontend only, mock data, no backend)
# Build context: project root. Published by CI as <repo>/demo.
# See docs/features/demo-mode.md.
# ============================================================

FROM --platform=$BUILDPLATFORM oven/bun:alpine AS build

WORKDIR /build/frontend

COPY frontend/package.json frontend/bun.lock ./
RUN bun install --frozen-lockfile

# Declared after the install: a new version must not invalidate the dependency layer.
ARG APP_VERSION=dev
ENV VITE_DEMO_MODE=true
ENV VITE_APP_VERSION=$APP_VERSION

COPY frontend/ .
RUN bun run build

# Static files only: the demo adapter answers every API call in the browser.
FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY --from=build /build/frontend/dist /usr/share/nginx/html
COPY <<'CONF' /etc/nginx/conf.d/default.conf
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;
    }
}
CONF

EXPOSE 8080
