# ─────────────────────────────────────────────────────────────────────────
# Picsou — Docker environment
#
# Zero-config first boot:
#   `docker compose -f docker/docker-compose.yml up -d` starts the app and the
#   database. To sync a bank through a connector, set COMPOSE_PROFILES and
#   APP_SIDECAR_API_KEY below first. The
#   app auto-generates JWT_SECRET and CRYPTO_ENCRYPTION_KEY on first
#   launch (persisted to the `picsou_data` named volume under
#   /data/.secrets/), and the setup wizard at http://localhost:8080
#   collects the rest interactively.
#
# Advanced: any value set here overrides the auto-generated one. Useful
# for CI, external secret managers, or keeping secrets out of the named
# volume (e.g. if you manage them with Vault).
# ─────────────────────────────────────────────────────────────────────────

# Database (defaults: picsou/picsou/picsou)
POSTGRES_DB=picsou
POSTGRES_USER=picsou
# Shared by the app and the database. Set it before the first start: changing it
# later does not change the password of an initialized database volume.
# POSTGRES_PASSWORD=         # leave blank → picsou

# Secrets (auto-generated on first boot if left blank)
# JWT_SECRET=                # openssl rand -base64 48
# CRYPTO_ENCRYPTION_KEY=     # openssl rand -base64 32

# Bank connectors: none runs unless its Compose profile is enabled. List the banks
# you use, comma-separated, or all-connectors for every one. Profiles: amex, amundi,
# banque-populaire, bnp, bourse-direct, bourso, caisse-epargne, cic, cmes, corum, degiro,
# fortuneo, lbp, natixis, revolut, sofidy, tr (Trade Republic). An install upgraded from a version that ran every
# connector should set all-connectors (or its own banks) to keep them managed.
# COMPOSE_PROFILES=bourso,revolut

# Shared secret between the app and the enabled *-auth connectors. Required as soon
# as one connector is enabled: the app and the connectors refuse to talk without it.
# Generate with openssl rand -base64 32; no default is provided.
# APP_SIDECAR_API_KEY=

# App credentials — leave blank to create them via the setup wizard on first launch.
# Only set these if you want to seed an admin programmatically (CI, automated installs).
# APP_USERNAME=admin
# APP_PASSWORD_HASH=$2a$12$REPLACE_THIS_WITH_REAL_BCRYPT_HASH

# CORS — leave blank to configure via the wizard (auto-detected from browser origin).
# ALLOWED_ORIGINS=http://your-nas-ip:8080

# MCP transport (optional). SSE is the default for existing clients.
# Use STREAMABLE for claude.ai and protocol 2025-11-25 at /mcp.
# Recreate the app container after changing this value; configure other clients for HTTP.
# See docs/features/mcp-server.md for client configuration and rollback.
# MCP_PROTOCOL=STREAMABLE
# MCP_KEEP_ALIVE_INTERVAL=60s

# ─── Single sign-on (OIDC, optional) ─────────────────────────────────────
# SSO is on only when SSO_ISSUER_URI and SSO_CLIENT_ID are both set. An invalid value logs an
# ERROR and leaves SSO off; it never stops the app. Password login keeps working either way.
# Register at the IdP: redirect URI  https://<host>/login/sso/callback
#                      post-logout URI https://<host>/login  (only with SSO_IDP_LOGOUT=true)
# SSO_ISSUER_URI must equal the `issuer` of the IdP discovery document character for character
# (a trailing slash included), e.g. https://idp.example.com or https://idp.example.com/realms/home
# SSO_ISSUER_URI=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=                 # blank → public client (PKCE only); set → client_secret_basic + PKCE
# SSO_PROVIDER_NAME=SSO              # button label: "Sign in with <name>" (max 40 characters)
# SSO_SCOPES=openid,profile,email    # `openid` is always added; add `groups` for IdPs that need it (Pocket ID, Authelia)
# SSO_GROUPS_CLAIM=groups            # literal claim name, e.g. urn:zitadel:iam:org:project:roles
# SSO_ADMIN_GROUP=                   # turns on SSO first admin, admin provisioning and role sync
# SSO_SESSION_REVALIDATE_AFTER=24h   # maximum age of an SSO session before it passes through the IdP again
# SSO_IDP_LOGOUT=false               # also end the IdP session on logout
# Zitadel: give Picsou its own project (a role shared with other apps grants Picsou admin), enable
# "Assert Roles on Authentication" on it, and attach the groups Action to "Pre Userinfo creation".
# Do not request the `groups` scope when using that Action (it would fill `groups` from Zitadel's own
# user groups and an Action cannot overwrite it). Or skip the Action and set
# SSO_GROUPS_CLAIM=urn:zitadel:iam:org:project:roles.

# ─── HTTPS (compose profile `tls`) ───────────────────────────────────────
# Add `tls` to COMPOSE_PROFILES to run a Caddy TLS terminator in front.
# REQUIRED for Enable Banking: it rejects plain-HTTP callback URLs on
# PRODUCTION applications, and PRODUCTION is the only mode listing real banks.
#
# Turn this on BEFORE the first launch. The setup wizard stores the callback
# URL, allowed origins and cookie flag derived from whatever origin you open
# it on, and those DB rows then take precedence over this file — enabling TLS
# afterwards means correcting three settings by hand in the Admin page
# (README step 3f).
#
# Caddy picks the certificate strategy from this hostname on its own:
#   • public FQDN  → Let's Encrypt. Trusted everywhere, zero manual steps.
#                    Needs the name to resolve here and :80 + :443 reachable.
#   • LAN IP or a .local / .internal / .localhost name → Caddy's internal CA.
#                    No domain needed, but install its root once per device
#                    (see README, "HTTPS for the Docker stack").
# PICSOU_DOMAIN=picsou.example.com

# Caddy reaches the app over a dedicated /29 network. The app trusts only this exact
# proxy address for the forwarded client IP. Docker assigns app and migration
# container addresses from IP_RANGE, which must be inside SUBNET and exclude
# Caddy's address and the gateway. Keep at least two usable addresses for the
# live app and one migration container. Change all three if the subnet overlaps.
# PICSOU_PROXY_SUBNET=172.30.253.0/29
# PICSOU_PROXY_IP=172.30.253.2
# PICSOU_PROXY_IP_RANGE=172.30.253.4/30

# To stop answering plain HTTP on the LAN once TLS works, add the overlay file
# rather than an env var:  -f docker/docker-compose.no-http.yml   (README 3d)

# HSTS — leave OFF with a locally-issued (internal-CA / mkcert) certificate.
# The browser would remember the policy and drop the "proceed anyway" bypass,
# locking you out of the app. Safe to enable once the cert is publicly trusted.
# Accepted: true / 1 / yes / on (case-insensitive). Anything else disables it
# and logs a warning at startup.
# HSTS_ENABLED=true

# Enable Banking — configure via the wizard's guided flow. Only set manually if you
# already have PSD2 credentials and a generated key pair.
# The redirect URI must be https:// and must match the Enable Banking portal exactly.
# ENABLEBANKING_APPLICATION_ID=
# ENABLEBANKING_KEY_ID=
# ENABLEBANKING_REDIRECT_URI=https://picsou.example.com/sync/callback
# ENABLEBANKING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----

# Bank connector sidecar URLs default to their Compose service names; the
# defaults live in backend/src/main/resources/application.yml. Override one
# only to reach a sidecar elsewhere, e.g. BOURSO_AUTH_URL=http://bourso-auth:8001.

# Secure cookies — set to false when serving over plain HTTP (no TLS terminator).
# The wizard auto-detects this from the browser's protocol.
# SECURE_COOKIES=true

# ── AI transaction categorization (optional) ───────────────────────────────
# Configured entirely in the app: Admin → Settings → AI categorization
# (provider, API key, model, base URL — stored encrypted in the database).
# For a local model, run the bundled Ollama service:
#   docker compose --profile ollama up -d ollama
#   docker compose exec ollama ollama pull qwen3:0.6b
# then in Admin → Settings pick "Ollama (local)" with base URL http://ollama:11434

# Spring profile
SPRING_PROFILES_ACTIVE=prod
