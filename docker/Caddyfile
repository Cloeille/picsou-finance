# ─────────────────────────────────────────────────────────────────────────
# Picsou — optional TLS terminator (compose profile `tls`).
#
# Why this exists: Enable Banking rejects plain-HTTP callback URLs for
# PRODUCTION applications, and PRODUCTION is the only mode that exposes real
# banks. So bank sync is unusable on an HTTP-only deployment, no matter how
# the redirect URI is configured. See docs/features/bank-sync.md.
#
# PICSOU_DOMAIN decides how the certificate is obtained — Caddy makes that
# choice on its own, from the hostname, with no configuration from you:
#
#   • Public FQDN (picsou.example.com) → ACME (Let's Encrypt / ZeroSSL).
#     Publicly trusted, fully automatic, nothing to install on any device.
#     Needs the name to resolve to this host and :80 + :443 reachable.
#
#   • Local name — the default `picsou.localhost`, anything under .local /
#     .internal / .home.arpa, or a bare LAN IP → Caddy's built-in CA issues
#     the certificate locally. No domain and no internet access required,
#     but each browser must trust the root once (README explains how).
#
# Deliberately absent: Strict-Transport-Security. With a locally-issued
# certificate an HSTS entry is a one-way trap — the browser stops offering
# the "proceed anyway" bypass and locks the user out with no in-app
# recovery. HSTS is opt-in via HSTS_ENABLED once the cert is publicly
# trusted; see docker/entrypoint.sh.
# ─────────────────────────────────────────────────────────────────────────

{$PICSOU_DOMAIN:picsou.localhost} {
	# The app container serves nginx on 8080 (SPA + /api + /actuator).
	# app-tls resolves only on the dedicated Compose network, where Caddy has
	# the exact address configured as nginx's trusted forwarded-address peer.
	# Caddy sets X-Forwarded-Proto/Host/For by default; nginx resolves the
	# client address, replaces the forwarded chain with that single value,
	# and passes it to Tomcat's loopback-only RemoteIpValve.
	# Do NOT add `header_up X-Forwarded-For {remote_host}` here. Caddy already
	# sets X-Forwarded-For to the real peer address and ignores whatever the
	# client sent because `trusted_proxies` is empty. Stating it explicitly is
	# redundant and makes Caddy log "Unnecessary header_up X-Forwarded-For".
	reverse_proxy app-tls:8080
}
