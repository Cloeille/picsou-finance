# ─────────────────────────────────────────────────────────────────────────
# Picsou — bare-metal environment
#
# Zero-config first boot:
#   Run `./backend/scripts/picsou-init.sh > .env.local`, source it, then
#   `mvn spring-boot:run`. Everything else — admin user, CORS, Enable
#   Banking, etc. — is collected by the setup wizard at first launch.
#
# All values below are optional; set them only to override the defaults
# the wizard would otherwise ask you about.
# ─────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────
POSTGRES_DB=picsou
POSTGRES_USER=picsou
# POSTGRES_PASSWORD=           # leave blank → generated by picsou-init.sh
# Direct JDBC overrides (bare-metal / external database). Defaults derive
# from the POSTGRES_* values above in Docker; on bare metal the backend
# falls back to jdbc:postgresql://localhost:5432/picsou / picsou / picsou.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/picsou
# SPRING_DATASOURCE_USERNAME=picsou
# SPRING_DATASOURCE_PASSWORD=picsou

# ─── Secrets (auto-generated by picsou-init.sh if blank) ─────────────────
# JWT_SECRET=                  # openssl rand -base64 48
# CRYPTO_ENCRYPTION_KEY=       # openssl rand -base64 32

# ─── App credentials — configure via the setup wizard ────────────────────
# Only set these to skip the wizard (CI, automated provisioning).
# APP_USERNAME=admin
# APP_PASSWORD_HASH=$2a$12$REPLACE_WITH_REAL_BCRYPT_HASH

# ─── CORS — configure via the wizard ─────────────────────────────────────
# ALLOWED_ORIGINS=https://localhost:5173

# ─── Enable Banking — use the wizard's guided flow ───────────────────────
# Set these only if you already have credentials and a key pair.
# ENABLEBANKING_APPLICATION_ID=
# ENABLEBANKING_KEY_ID=
# ENABLEBANKING_REDIRECT_URI=https://localhost:5173/sync/callback
# ENABLEBANKING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----
# Dev profile only: load the key from a file instead of the env var.
# ENABLEBANKING_PRIVATE_KEY_PATH=.local/keys/enablebanking-private.pem
# API base URL override (sandbox testing).
# ENABLEBANKING_BASE_URL=https://api.enablebanking.com

# ─── BoursoBank sidecar (optional override) ──────────────────────────────
# Docker Compose configures this internal URL automatically. For local
# backend development, run the sidecar on port 8004.
# BOURSO_AUTH_URL=http://127.0.0.1:8004

# ─── Bourse Direct sidecar (optional override) ───────────────────────────
# Docker Compose configures this internal URL automatically. For local
# backend development, run the sidecar on port 8002.
# BOURSE_DIRECT_AUTH_URL=http://127.0.0.1:8002

# ─── Amundi Épargne Salariale sidecar (optional override) ───────────────
# Docker Compose configures this internal URL automatically. For local
# backend development, run the sidecar on port 8003.
# AMUNDI_AUTH_URL=http://127.0.0.1:8003

# ─── Fortuneo sidecar (optional override) ───────────────────────────────
# Docker Compose configures this internal URL automatically. For local
# backend development, run the sidecar on port 8005.
# FORTUNEO_AUTH_URL=http://127.0.0.1:8005

# ─── Powens / Budget Insight (⚠ EXPERIMENTAL — DISABLED IN 1.0.0) ────────
# The Powens adapter is shipped but UNTESTED end-to-end against a real
# tenant. It is no longer @Primary, so even if you set POWENS_CLIENT_ID
# Enable Banking remains the canonical provider. Do not enable on prod.
# POWENS_CLIENT_ID=
# POWENS_CLIENT_SECRET=
# POWENS_DOMAIN=
# POWENS_REDIRECT_URI=http://localhost:5173/sync/callback

# ─── 2FA / Persistent sessions (optional overrides) ──────────────────────
# Defaults are sane; override only if you need to.
# APP_MFA_ISSUER=Picsou                           # name shown in authenticator apps
# APP_JWT_MFA_CHALLENGE_EXPIRY_MINUTES=5          # mfa_challenge cookie TTL (minutes)
# APP_PERSISTENT_SESSION_EXPIRY_DAYS=90           # "Remember Me" token TTL (days)

# ─── Crypto encryption key — file location (optional override) ───────────
# Where the wizard writes the auto-generated key when CRYPTO_ENCRYPTION_KEY
# is not provided via env. Must live on a persistent volume.
# APP_CRYPTO_KEY_PATH=/data/.secrets/crypto_key

# ─── Secure cookies — the wizard detects this from your browser origin ──
# SECURE_COOKIES=true

# ─── HSTS (Strict-Transport-Security) ────────────────────────────────────
# Off by default. When true, the backend sends HSTS on its responses, which is
# enough to set the policy for the whole host.
#
# Enable ONLY behind a publicly-trusted certificate. With a locally-issued one
# (mkcert, Caddy's internal CA) the browser remembers the policy and then
# refuses the "proceed anyway" bypass for a certificate it does not trust —
# locking you out with no in-app recovery. Accepted: true / 1 / yes / on.
# HSTS_ENABLED=true

# ─── Public base URL (used in admin-recovery URL output) ─────────────────
# Where users reach the frontend. Used to print the activate URL during
# admin recovery. Defaults to http://localhost:5173.
# PUBLIC_BASE_URL=https://picsou.example.com

# ─── Admin password recovery (DANGEROUS — use only when locked out) ──────
# Set to true ONE TIME if you've lost the admin password. On next boot,
# Picsou will generate a fresh activation token for every admin account
# and print the URL to the application logs (look for the WARN banner
# "ADMIN RECOVERY ACTIVATED"). Use the URL to set a new password, then
# set this back to false and restart. All previous sessions are
# invalidated when the recovery token is generated.
# NEVER leave this enabled in normal operation.
# ADMIN_RECOVERY_ENABLED=false

# ─── MCP server (Model Context Protocol) ─────────────────────────────────
# Embedded MCP server exposing a curated, member-scoped tool surface to AI
# clients, authenticated with per-member access-keys (Settings → Access keys).
# Transport is HTTP+SSE at /mcp (stream) and /mcp/message (messages). Set to
# false to disable the endpoint entirely. Serve over HTTPS in production.
# MCP_ENABLED=true

# ── AI transaction categorization (optional) ───────────────────────────────
# Configured entirely in the app: Admin → Settings → AI categorization
# (provider, API key, model, base URL — stored encrypted in the database).
# For a local model, run the bundled Ollama service:
#   docker compose --profile ollama up -d ollama
#   docker compose exec ollama ollama pull qwen3:0.6b
# then in Admin → Settings pick "Ollama (local)" with base URL http://ollama:11434

# ─── Real-estate valuation (French open data) ────────────────────────────
# No credentials of any kind: every source below is Licence Ouverte 2.0 and
# unauthenticated. Override the URLs only to point at a mirror or to pin a
# host; leave them unset otherwise.
#
# Set to false to disable all outbound valuation/geocoding calls. Properties
# then keep whatever value was last written.
# VALUATION_ENABLED=true
# Cerema DV3F market indicators (median price/m² per commune, from DGFiP data).
# CEREMA_API_URL=https://apidf-preprod.cerema.fr
# INSEE housing price index, used to carry a DVF vintage forward to today.
# INSEE_API_URL=https://api.insee.fr/series/BDM/V1
# IGN Géoplateforme address geocoding. NOT api-adresse.data.gouv.fr: that host
# was decommissioned in January 2026 and only survives as a redirect.
# GEOCODING_API_URL=https://data.geopf.fr/geocodage

# ─── Spring profile ──────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ─── Dev / test / build only — never needed on a deployed instance ───────
# Trade Republic auth sidecar URL (dev profile default: http://127.0.0.1:8001)
# TR_AUTH_URL=http://127.0.0.1:8001

# ─── Optional build metadata — surfaces the app version in the UI/API ────
# Injected by CI (GITHUB_SHA) at build time; unset falls back to "dev".
# APP_VERSION=dev
# VITE_APP_VERSION=dev
# Frontend dev-server port override (parallel worktrees, preview harnesses).
# PORT=5173
# Playwright E2E targets.
# PLAYWRIGHT_BASE_URL=https://localhost:5173
# PLAYWRIGHT_DEV_URL=https://localhost:5173
